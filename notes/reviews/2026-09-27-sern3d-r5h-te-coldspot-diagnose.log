   223	            h_lo = max(lo - y_bot, 1e-12); h_up = max(yt[i] - up, 1e-12)
   224	            s_bot = _radial_fracs(njb, min(f_lo / h_lo, 0.5 / (njb - 1)))
   225	            s_top = _tanh_two_sided(njt, min(f_up / h_up, 0.5 / (njt - 1)))
   226	            Y[i, :njb] = y_bot + s_bot * (lo - y_bot)
   227	            Y[i, jm:] = up + s_top * (yt[i] - up)
   228	            # j = jm は**下バンドの壁ノード (cowl_out)**。上の 2 行では `up` で上書きされ、
   229	            # `Yin[i,jm]` が上面になって板厚が消えていた (cowl_in と cowl_out が同一座標の
   230	            # **厚さ 0 スリット**。`cowl_thickness` が 3D で効いていなかった。2026-09-20 修正)。
   231	            # 代入は `lo` **そのもの** (`y_bot + 1.0*(lo-y_bot)` は丸めで一致しない)。
   232	            Y[i, jm] = lo
   233	    # --- ノード番号 ---
   234	    N_base = ni * NJ * nz
   235	    def base(i, j, k): return (i * NJ + j) * nz + k
   236	    dup1 = {}   # (i,k) -> id  (カウル上コピー)
   237	    dup2 = {}   # (i,j) -> id  (側壁外コピー, k=k_sw)
   238	    nid = N_base
   239	    for i in range(i_te):
   240	        for k in range(k_sw + 1):
   241	            if k == k_sw and i >= i_sw and not no_outer and prm.share_cowl_free_edge:
   242	                continue                       # 板の自由な側端: 上下で共有 (node() が base に落ちる)
   243	            dup1[(i, k)] = nid; nid += 1
   244	    for i in (range(0) if no_outer else range(i_sw)):   # 側壁後縁 (i_sw) は共有 (カウル TE と同じ)。外側空間なしなら重複なし
   245	        for j in range(jm + 1, NJ):            # ランプ線 (j = NJ−1) も内外 2 重: 共有すると入口面で
   246	            dup2[(i, j)] = nid; nid += 1       # inlet_nozzle と inlet_ext の両方に属し step 3 で発散した
   247	    # 板厚の z 分布: 側壁 (z = W/2) は**厚さ 0 のスリット**なので、そこまで板厚を効かせると
   248	    # スリットの内外で中間線の高さがずれ、側壁後縁が破綻する (run_0086: 暖機段 step 4 で ro NaN)。
   249	    # 最後の 2 セルで厚さを 0 に絞り、k_sw では内外が一致するようにする。
   250	    sz = np.ones(nz)
   251	    if t_c > 0.0:
   252	        kt = max(k_sw - 2, 0)
   253	        if k_sw > kt:
   254	            u = (zs[kt:k_sw + 1] - zs[kt]) / max(zs[k_sw] - zs[kt], 1e-30)
   255	            sz[kt:k_sw + 1] = 1.0 - u * u * (3.0 - 2.0 * u)
   256	        sz[k_sw + 1:] = 0.0
   257	    # 板の半厚 (x station, z ごと)。**float32 で解けない厚みは 0 に丸める**: 変換器は座標を float32 で
   258	    # 書くので、解けない隙間を残すと双子ノード (cowl_in / cowl_out) が「ほぼ一致」になり、
   259	    # 衝突するかどうかが丸めに依存する。**設計どおり閉じるところは厳密に閉じる**
   260	    # ([[axisym-rweight-closure-fp32]] と同じ方針)。閉じた列は上下とも同じ量だけ動かさない。
   261	    _half = 0.5 * tk[:, None] * sz[None, :]                       # (ni, nz)
   262	    _closed = _half < (1.0e-5 * np.maximum(1.0, np.abs(ym))[:, None])
   263	    _szw = np.where(_closed, 0.0, 1.0) * sz[None, :]              # (ni, nz) 実効 sz
   264	    coords = np.zeros((nid, 3))
   265	    for i in range(ni):
   266	        for j in range(NJ):
   267	            b = base(i, j, 0)
   268	            coords[b:b + nz, 0] = xs[i]; coords[b:b + nz, 2] = zs
   269	            # base(i, jm, k) は「下側 (cowl_out)」。板がある内側 (k <= k_sw) だけ Yin、外側は Y2 (= 単一の中間線)。
   270	            coords[b:b + nz, 1] = Y2[i, j]
   271	            if t_c > 0.0 and tk[i] > 0.0:
   272	                coords[b:b + nz, 1] += (Yin[i, j] - Y2[i, j]) * _szw[i]
   273	    n_dup_cowl_closed = 0
   274	    for (i, k), n in dup1.items():
   275	        coords[n] = (xs[i], ym[i] + 0.5 * tk[i] * _szw[i, k], zs[k])   # 上側 (cowl_in)
   276	        if t_c <= 0.0 or tk[i] <= 0.0 or _closed[i, k]:
   277	            n_dup_cowl_closed += 1                 # 座標一致の双子 (設計どおり閉じた列)
   278	    for (i, j), n in dup2.items():
   279	        coords[n] = (xs[i], Y2[i, j], zs[k_sw])
   280	
   281	    def node(i, j, k, side: str):
   282	        """side: 'lo' (下バンド), 'up_in' (上バンド, 内側 z<=W/2), 'up_out' (上バンド, 外側 z>W/2)。"""
   283	        if j == jm:
   284	            if side == "up_in" and (i, k) in dup1:
   285	                return dup1[(i, k)]
   286	            return base(i, j, k)
   287	        if side == "up_out" and k == k_sw and (i, j) in dup2:
   288	            return dup2[(i, j)]
   289	        return base(i, j, k)
   290	
     1	# Forge ソルバー設定リファレンス
     2	
     3	> **位置づけ**: 本文書は `solverConfig.yaml` の**運用上の設定リファレンス** (各設定の意味・正しい使い方・注意点) である。
     4	> スキームの理論的背景や実装の詳細は `methods/<area>/` を参照すること (例: 対流スキームは [`../methods/convection/`](../methods/convection/)、
     5	> 時間積分は [`../methods/time_integration/`](../methods/time_integration/))。ここは「どの値を選ぶか」、`methods/` は「なぜそう動くか」を担う。
     6	
     7	この文書は `solverConfig.yaml` の主要な数値設定について、正しい使い方と注意点をまとめたものです。解析設定を変更するときは、**必ずこのファイルを参照してから**変更を行うこと。
     8	
     9	## convMethod — 対流スキームの次数
    10	
    11	| 値 | スキーム | 説明 |
    12	|---|---|---|
    13	| `0` | 1次風上 | 安定性が高い。収束困難なケースの初期化や発散回避に使う |
    14	| `1` | 2次風上 | 通常の高精度計算に使う |
    15	| `2` | 3次 MUSCL | より高精度だが計算コスト増。安定した解が得られてから使う |
    16	
    17	## limiter — リミタ
    18	
    19	| 値 | リミタ | 説明 |
    20	|---|---|---|
    21	| `0` | なし | **リミタ無しのため最も発散しやすい。** 基本的に単体では使わない |
    22	| `1` | Barth | |
    23	| `2` | Venkatakrishnan | 通常使用するリミタ。`convMethod: 1` または `2` と組み合わせる |
    24	
    25	## 推奨組み合わせ
    26	
    27	| 用途 | convMethod | limiter |
    28	|---|---|---|
    29	| 初期化・発散回避 | `0` | `2` |
    30	| 通常の高精度計算 | `1` | `2` |
    31	| 高精度（安定解から） | `2` | `2` |
    32	
    33	**`limiter: 0` は原則使用しない。** 意図的に使う場合は理由を明記すること。
