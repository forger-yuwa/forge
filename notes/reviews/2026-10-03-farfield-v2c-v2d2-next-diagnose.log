   433	// dual-time: 物理時間 BDF 項を残差に加える（assembleResidual の末尾で呼ぶ）。
   434	// res は -R_spatial（陽解法 Q=Q_N+res·dt/V と整合）。dual-time の残差 R* = R_spatial + (V/Δt)(a Q - b Q^n + c Q^{n-1})
   435	// を 0 にするので res* = res - (V/Δt)(a Q - b Q^n + c Q^{n-1}) とする（roN=Q^n, roNN=Q^{n-1}）。
   436	// (a,b,c): BDF1=(1,1,0), BDF2=(1.5,2,0.5)。include_scalar==1 で k/ω も処理。
   437	__global__ void addUnsteadyTimeTerm_d
   438	(
   439	 geom_int nCells,
   440	 geom_float* vol,
   441	 flow_float dt_phys,
   442	 flow_float a, flow_float b, flow_float c,
   443	
   444	 flow_float* ro,   flow_float* roUx,   flow_float* roUy,   flow_float* roUz,   flow_float* roe,
   445	 flow_float* roN,  flow_float* roUxN,  flow_float* roUyN,  flow_float* roUzN,  flow_float* roeN,
   446	 flow_float* roNN, flow_float* roUxNN, flow_float* roUyNN, flow_float* roUzNN, flow_float* roeNN,
   447	 flow_float* res_ro, flow_float* res_roUx, flow_float* res_roUy, flow_float* res_roUz, flow_float* res_roe,
   448	
   449	 int include_scalar,
   450	 flow_float* roK,   flow_float* roOmega,
   451	 flow_float* roKN,  flow_float* roOmegaN,
   452	 flow_float* roKNN, flow_float* roOmegaNN,
   453	 flow_float* res_roK, flow_float* res_roOmega,
   454	 int energyK   // sstEnergyIncludesK: エネルギー行の BDF を E_t = roe + roK に (plan turbulence-sst-energy-includes-k §4.4a)
   455	)
   456	{
   457	    geom_int ic = blockDim.x*blockIdx.x + threadIdx.x;
   458	    if (ic < nCells) {
   459	        const flow_float coef = vol[ic] / max(dt_phys, static_cast<flow_float>(1.0e-30));
   460	        res_ro[ic]   -= coef * (a*ro[ic]   - b*roN[ic]   + c*roNN[ic]);
   461	        res_roUx[ic] -= coef * (a*roUx[ic] - b*roUxN[ic] + c*roUxNN[ic]);
   462	        res_roUy[ic] -= coef * (a*roUy[ic] - b*roUyN[ic] + c*roUyNN[ic]);
   463	        res_roUz[ic] -= coef * (a*roUz[ic] - b*roUzN[ic] + c*roUzNN[ic]);
   464	        res_roe[ic]  -= coef * (a*roe[ic]  - b*roeN[ic]  + c*roeNN[ic]);
   465	        if (energyK != 0 && include_scalar) {
   466	            // E_t の時間項: 平均流 E_m の項に加えて ρk の BDF を足す (k 式側の時間項とは別勘定。E_t 式の保存は subiter 収束で成立)
   467	            res_roe[ic] -= coef * (a*roK[ic] - b*roKN[ic] + c*roKNN[ic]);
   468	        }
   469	        if (include_scalar) {
   470	            res_roK[ic]     -= coef * (a*roK[ic]     - b*roKN[ic]     + c*roKNN[ic]);
   471	            res_roOmega[ic] -= coef * (a*roOmega[ic] - b*roOmegaN[ic] + c*roOmegaNN[ic]);
   472	        }
   473	    }
   474	}
