     7	// Limiters for Unstructured Higher-Order Accurate Solutions of the Euler Equations
     8	// Krzysztof Michalak
     9	
    10	__device__ flow_float venkata_limiter(flow_float delta_p_max, flow_float delta_p_min, 
    11	                                      flow_float delta_m, flow_float volume) {
    12	
    13	    flow_float K = 1.f;
    14	    flow_float eps2 = K*K*K*volume;
    15	    //return (x*x + 2.0*x + eps*eps)/(x*x + x + 2.0 + eps*eps);
    16	    flow_float res;
    17	
    18	    // K11: 元は /(...)/delta_m と除算2回。/(denom*delta_m) に統合して除算1回に（compute律速の limiter 向け）。
    19	    if (delta_m > 1e-20f) {
    20	        flow_float delta_p = delta_p_max;
    21	        res = ((delta_p*delta_p+eps2)*delta_m +2*delta_m*delta_m*delta_p)
    22	              /((delta_p*delta_p +2.0f*delta_m*delta_m +delta_p*delta_m +eps2)*delta_m);
    23	    } else if (delta_m < -1e-20f) {
    24	        flow_float delta_p = delta_p_min;
    25	        res = ((delta_p*delta_p+eps2)*delta_m +2*delta_m*delta_m*delta_p)
    26	              /((delta_p*delta_p +2.0f*delta_m*delta_m +delta_p*delta_m +eps2)*delta_m);
    27	    } else {
    28	        res = 1.0f;
    29	    }
    30	
    31	    return res;
    32	}
    33	
    34	// 無次元化版 Venkatakrishnan (plan convection-node-wall-reconstruction §4.13)。
    35	// 呼び出し側が delta を**変数ごとの固定物理参照**で割って渡し、eps2 も無次元で渡す
    36	// (eps2 = (K * h_i / L_ref)^3)。現行版との違いは 2 つ:
    37	//   (1) eps2 が変数の次元と無関係でなくなる (現行の eps2 = K^3*volume は sqrt(volume) が
    38	//       変数の値と同じ大きさになると一切制限しない — 密度で実際に起きた)
    39	//   (2) 分子分母の余分な delta_m 因子を**約分**してある。現行の 3 次積は
    40	//       K=0, dp=0, dm=1e-19 で 0/0 -> NaN になる (codex plan-2 M4 が float32 で再現)
    41	__device__ flow_float venkata_limiter_scaled(flow_float delta_p_max, flow_float delta_p_min,
    42	                                             flow_float delta_m, flow_float eps2) {
    43	    const flow_float delta_p = (delta_m > (flow_float)0.0) ? delta_p_max : delta_p_min;
    44	    const flow_float num = delta_p*delta_p + eps2 + (flow_float)2.0*delta_m*delta_p;
    45	    const flow_float den = delta_p*delta_p + (flow_float)2.0*delta_m*delta_m + delta_p*delta_m + eps2;
    46	    return (den > (flow_float)0.0) ? num/den : (flow_float)1.0;
    47	}
    48	
    49	
    50	// **比の形** Venkatakrishnan (plan convection-node-wall-reconstruction §4.18)。
    51	// y = delta_p / delta_m (許容幅 / 再構成増分) の**無次元な比**だけで決まるので、
    52	// 基準値 (ro_ref / p_ref / a_ref) も長さ尺度も要らない。eps は**ただの数**。
    53	// このファイル冒頭が引用している Michalak の流儀で、現行実装の 1 行上に
    54	//   //return (x*x + 2.0*x + eps*eps)/(x*x + x + 2.0 + eps*eps);
    55	// とコメントアウトされていた形そのもの。
    56	//   y -> 0 で psi -> eps^2/(2+eps^2) ~ 0、y -> 無限大で psi -> 1、y=1 で 3/4。
    57	//   psi <= y なので Barth の有界性を満たす (y>2 で psi>1 になるが呼び出し側が 1 でクランプする)。
    58	// **代償**: 尺度を持たないので「ほぼ一様な領域の数値ノイズは制限しない」という
    59	// Venkatakrishnan 本来の性質を失う。収束の鈍りが出ないかは実測で見る (§4.18)。
    60	
    61	
    62	__device__ flow_float barth_Jespersen_limiter(flow_float delta_p_max, flow_float delta_p_min, 
    63	                                              flow_float delta_m, flow_float volume) {
    64	
    65	    flow_float res;
    66	
    67	    if (delta_m > 1e-20f) {
    68	        res = min(1.0f, delta_p_max/delta_m);
    69	    } else if (delta_m < -1e-20f) {
    70	        res = min(1.0f, delta_p_min/delta_m);
    71	    } else {
    72	        res = 1.0f;
    73	    }
    74	
    75	    return min(res, 1.0f);
    76	}
